<script>


// ======================================================
// COMPROBAR THREE
// ======================================================

if (
    typeof THREE === "undefined"
) {

    alert(
        "No se pudo cargar Three.js. Comprueba tu conexión a Internet."
    );

    throw new Error(
        "Three.js no cargado."
    );

}


// ======================================================
// ESCENA
// ======================================================

const escena =
    new THREE.Scene();

escena.background =
    new THREE.Color(
        0x030404
    );

escena.fog =
    new THREE.FogExp2(
        0x030404,
        .025
    );


// ======================================================
// CÁMARA
// ======================================================

const camara =
    new THREE.PerspectiveCamera(
        75,

        window.innerWidth /
        window.innerHeight,

        .1,

        200
    );

camara.position.set(
    0,
    1.7,
    8
);


// ======================================================
// RENDER
// ======================================================

const render =
    new THREE.WebGLRenderer({
        antialias: true
    });

render.setSize(
    window.innerWidth,
    window.innerHeight
);

render.setPixelRatio(
    Math.min(
        window.devicePixelRatio,
        2
    )
);

render.shadowMap.enabled =
    true;

document.body.appendChild(
    render.domElement
);


// ======================================================
// LUZ
// ======================================================

const luzAmbiente =
    new THREE.HemisphereLight(
        0x68757d,
        0x050505,
        .5
    );

escena.add(
    luzAmbiente
);


const luzPrincipal =
    new THREE.DirectionalLight(
        0x9ba9b5,
        1
    );

luzPrincipal.position.set(
    -10,
    20,
    10
);

luzPrincipal.castShadow =
    true;

escena.add(
    luzPrincipal
);


// ======================================================
// SUELO
// ======================================================

const suelo =
    new THREE.Mesh(
        new THREE.PlaneGeometry(
            100,
            100
        ),

        new THREE.MeshStandardMaterial({
            color: 0x171a19,
            roughness: 1
        })
    );

suelo.rotation.x =
    -Math.PI / 2;

suelo.receiveShadow =
    true;

escena.add(
    suelo
);


// ======================================================
// FUNCIÓN CUBO
// ======================================================

function cubo(
    x,
    y,
    z,
    sx,
    sy,
    sz,
    color
) {

    const objeto =
        new THREE.Mesh(

            new THREE.BoxGeometry(
                sx,
                sy,
                sz
            ),

            new THREE.MeshStandardMaterial({
                color: color,
                roughness: .9
            })

        );

    objeto.position.set(
        x,
        y,
        z
    );

    objeto.castShadow =
        true;

    objeto.receiveShadow =
        true;

    escena.add(
        objeto
    );

    return objeto;
}


// ======================================================
// PAREDES
// ======================================================

cubo(
    -15,
    3,
    0,
    1,
    6,
    50,
    0x252927
);

cubo(
    15,
