    );

}


// ======================================================
// ZOMBIES
// ======================================================

const zombies = [];


function crearZombie(
    x,
    z
) {

    const zombie =
        new THREE.Group();


    // CUERPO

    const cuerpo =
        new THREE.Mesh(

            new THREE.CapsuleGeometry(
                .55,
                1.15,
                5,
                8
            ),

            new THREE.MeshStandardMaterial({
                color: 0x40504a,
                roughness: 1
            })

        );

    cuerpo.position.y =
        1.1;

    cuerpo.castShadow =
        true;

    zombie.add(
        cuerpo
    );


    // CABEZA

    const cabeza =
        new THREE.Mesh(

            new THREE.SphereGeometry(
                .43,
                16,
                12
            ),

            new THREE.MeshStandardMaterial({
                color: 0x66736b,
                roughness: 1
            })

        );

    cabeza.position.y =
        2.05;

    cabeza.castShadow =
        true;

    zombie.add(
        cabeza
    );


    // OJOS

    const materialOjos =
        new THREE.MeshBasicMaterial({
            color: 0xff1717
        });


    const ojoIzquierdo =
        new THREE.Mesh(
            new THREE.SphereGeometry(
                .06,
                8,
                8
            ),
            materialOjos
        );

    ojoIzquierdo.position.set(
        -.14,
        2.1,
        -.39
    );

    zombie.add(
        ojoIzquierdo
    );


    const ojoDerecho =
        new THREE.Mesh(
            new THREE.SphereGeometry(
                .06,
                8,
                8
            ),
            materialOjos
        );

    ojoDerecho.position.set(
        .14,
        2.1,
        -.39
    );

    zombie.add(
        ojoDerecho
    );


    // BRAZOS

    const brazoMaterial =
        new THREE.MeshStandardMaterial({
            color: 0x53615a
        });


    const brazoIzquierdo =
        new THREE.Mesh(
            new THREE.CylinderGeometry(
                .12,
                .15,
                1.1,
                8
            ),
            brazoMaterial
        );

    brazoIzquierdo.position.set(
        -.7,
        1.25,
        -.1
    );

    brazoIzquierdo.rotation.z =
        -.6;

    zombie.add(
        brazoIzquierdo
    );


    const brazoDerecho =
        new THREE.Mesh(
            new THREE.CylinderGeometry(
                .12,
                .15,
                1.1,
                8
            ),
            brazoMaterial
        );

    brazoDerecho.position.set(
        .7,
        1.25,
        -.1
    );

    brazoDerecho.rotation.z =
        .6;

    zombie.add(
        brazoDerecho
    );


    zombie.position.set(
        x,
        0,
        z
    );


    escena.add(
        zombie
    );


    zombies.push({
        objeto: zombie,
        vida: 3,
        vivo: true,
        velocidad:
            .5 +
            Math.random() * .35
    });

}


// ======================================================
// CREAR 8 ZOMBIES
// ======================================================

crearZombie(
    -10,
    -10
);

crearZombie(
    10,
    -8
);

crearZombie(
    -9,
    0
);

crearZombie(
