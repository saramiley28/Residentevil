    3
);

crearZombie(
    -10,
    13
);

crearZombie(
    10,
    15
);

crearZombie(
    -5,
    -18
);

crearZombie(
    5,
    -20
);


// ======================================================
// ESTADO DEL JUEGO
// ======================================================

let jugando =
    false;

let vida =
    100;

let municion =
    20;

let terminado =
    false;


// ======================================================
// BOTÓN JUGAR
// ======================================================

document
.getElementById(
    "jugar"
)
.addEventListener(
    "click",
    function() {

        jugando =
            true;

        document
        .getElementById(
            "inicio"
        )
        .style.display =
            "none";

        mostrarMensaje(
            "¡LOS ZOMBIES SE ACERCAN!"
        );

        // Capturar mouse

        document.body.requestPointerLock();

    }
);


// ======================================================
// TECLADO
// ======================================================

const teclas = {};


document.addEventListener(
    "keydown",
    function(e) {

        teclas[
            e.code
        ] = true;


        if (
            e.code === "Space"
        ) {

            disparar();

        }

    }
);


document.addEventListener(
    "keyup",
    function(e) {

        teclas[
            e.code
        ] = false;

    }
);


// ======================================================
// MOUSE
// ======================================================

let mouseActivo =
    false;

let rotacionY =
    0;

let rotacionX =
    0;


document.addEventListener(
    "pointerlockchange",
    function() {

        mouseActivo =
            document.pointerLockElement ===
            document.body;

    }
);


document.addEventListener(
    "mousemove",
    function(e) {

        if (
            !mouseActivo
        ) {

            return;

        }


        rotacionY -=
            e.movementX *
            .002;


        rotacionX -=
            e.movementY *
            .002;


        rotacionX =
            THREE.MathUtils.clamp(
                rotacionX,
                -1.4,
                1.4
            );


        camara.rotation.order =
            "YXZ";

        camara.rotation.y =
            rotacionY;

        camara.rotation.x =
            rotacionX;

    }
);


// ======================================================
// MOVIMIENTO
// ======================================================

const reloj =
    new THREE.Clock();


function moverJugador(
    delta
) {

    if (
        !jugando ||
        terminado
    ) {

        return;

    }


    const velocidad =
        4 * delta;


    const adelante =
        new THREE.Vector3();


    camara.getWorldDirection(
        adelante
    );

    adelante.y =
        0;

    adelante.normalize();


    const derecha =
        new THREE.Vector3();


    derecha.crossVectors(
        adelante,
        camara.up
    );

    derecha.normalize();


    if (
        teclas["KeyW"]
    ) {

        camara.position.addScaledVector(
            adelante,
            velocidad
        );

    }


    if (
        teclas["KeyS"]
    ) {

        camara.position.addScaledVector(
            adelante,
            -velocidad
        );

    }


    if (
        teclas["KeyA"]
    ) {

        camara.position.addScaledVector(
            derecha,
            velocidad
        );

    }


    if (
        teclas["KeyD"]
    ) {

        camara.position.addScaledVector(
            derecha,
            -velocidad
        );

    }

}


// ======================================================
// DISPARAR
// ======================================================

const ray =
    new THREE.Raycaster();

const direccion =
    new THREE.Vector3();


function disparar() {

    if (
        !jugando ||
        terminado
    ) {

        return;

    }


    if (
        municion <= 0
    ) {

        mostrarMensaje(
            "SIN MUNICIÓN"
        );

        return;

    }


    municion--;


    document
    .getElementById(
        "balas"
    )
    .textContent =
        municion;


    camara.getWorldDirection(
        direccion
    );


    ray.set(
        camara.position,
        direccion
    );


    const objetos = [];


    zombies.forEach(
        zombie => {

            if (
                zombie.vivo
            ) {

                objetos.push(
                    zombie.objeto
                );

            }

        }
    );


    const impactos =
        ray.intersectObjects(
            objetos,
            true
        );


    if (
        impactos.length === 0
    ) {

        return;

    }


    let objeto =
        impactos[0].object;


    while (
        objeto.parent
    ) {

        const encontrado =
            zombies.find(
                z =>
                    z.objeto ===
                    objeto
            );


        if (
            encontrado
        ) {

            const zombie =
                encontrado;

            zombie.vida--;


            if (
                zombie.vida <= 0
            ) {

                zombie.vivo =
                    false;

                escena.remove(
                    zombie.objeto
                );

                actualizarContador();

                mostrarMensaje(
                    "ZOMBIE ELIMINADO"
                );

            }


            break;

        }


        objeto =
            objeto.parent;

    }

}


// ======================================================
// IA ZOMBIES
// ======================================================

let ataqueTiempo =
    0;


function actualizarZombies(
    delta
) {

    if (
        !jugando ||
        terminado
    ) {

        return;

    }


    ataqueTiempo +=
        delta;


    zombies.forEach(
        zombie => {

            if (
                !zombie.vivo
            ) {

                return;

            }


            const objetivo =
                new THREE.Vector3(
                    camara.position.x,
                    0,
                    camara.position.z
                );


            const posicion =
                zombie.objeto.position;


            const distancia =
                posicion.distanceTo(
                    objetivo
                );


            if (
                distancia < 30
            ) {

                const direccion =
                    objetivo
                    .clone()
                    .sub(
                        posicion
                    )
                    .normalize();


                posicion.addScaledVector(
                    direccion,
                    zombie.velocidad *
                    delta
                );


                zombie.objeto.lookAt(
                    objetivo.x,
                    1,
                    objetivo.z
                );


                // Animación brazos

                zombie.objeto.rotation.z =
                    Math.sin(
                        Date.now() *
                        .006
                    ) * .08;


                // Ataque

                if (
                    distancia < 1.6 &&
                    ataqueTiempo > 1
                ) {

                    recibirDaño(
                        8
                    );

                    ataqueTiempo =
                        0;

                }

            }

        }
    );

}


// ======================================================
// DAÑO
// ======================================================

function recibirDaño(
    cantidad
) {

    vida -=
        cantidad;


    vida =
        Math.max(
            0,
            vida
        );


    document
    .getElementById(
        "salud"
    )
    .style.width =
        vida + "%";


    const efecto =
        document.getElementById(
            "daño"
        );


    efecto.style.opacity =
        "1";


    setTimeout(
        function() {

            efecto.style.opacity =
                "0";

        },
        150
    );


    if (
        vida <= 0
    ) {

        terminado =
            true;

        mostrarMensaje(
            "☠️ HAS MUERTO — PRESIONA R"
        );

    }

}


// ======================================================
// CONTADOR
// ======================================================

function actualizarContador() {

    const vivos =
        zombies.filter(
            z =>
                z.vivo
        ).length;


    document
    .getElementById(
        "zombies"
    )
    .textContent =
        vivos;


    if (
        vivos === 0
    ) {

        terminado =
            true;

        document
        .getElementById(
            "objetivo"
        )
        .textContent =
            "¡TODOS LOS ZOMBIES ELIMINADOS!";

        mostrarMensaje(
            "¡HAS SOBREVIVIDO!"
        );

    }

}


// ======================================================
// MENSAJES
// ======================================================

function mostrarMensaje(
    texto
) {

    const elemento =
        document.getElementById(
            "mensaje"
        );


    elemento.textContent =
        texto;


    elemento.style.opacity =
        "1";


    setTimeout(
        function() {

            elemento.style.opacity =
                "0";

        },
        2000
    );

}


// ======================================================
// REINICIAR
// ======================================================

document.addEventListener(
    "keydown",
    function(e) {

        if (
            e.code === "KeyR" &&
            terminado
        ) {

            location.reload();

        }

    }
);


// ======================================================
// ANIMACIÓN
// ======================================================

function animar() {

    requestAnimationFrame(
        animar
    );


    const delta =
        Math.min(
            reloj.getDelta(),
            .05
        );


    moverJugador(
        delta
    );


    actualizarZombies(
        delta
    );


    render.render(
        escena,
        camara
    );

}


animar();


// ======================================================
// RESIZE
// ======================================================

window.addEventListener(
    "resize",
    function() {

        camara.aspect =
            window.innerWidth /
            window.innerHeight;


        camara.updateProjectionMatrix();


        render.setSize(
            window.innerWidth,
            window.innerHeight
        );

    }
);


</script>

