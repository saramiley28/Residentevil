        );

    cubo(
        x,
        .7,
        z,
        1.5,
        1.4,
        1.5,
        0x3a3c38
    );

}


// ======================================================
// LUCES ROJAS
// ======================================================

for (
    let z = -20;
    z <= 20;
    z += 8
) {

    const luz =
        new THREE.PointLight(
            0xff321f,
            2,
            13
        );

